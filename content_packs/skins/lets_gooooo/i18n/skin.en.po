msgid "ui.product_name"
msgstr "Game Prototype"
msgid "ui.title.name"
msgstr "Game Prototype"
msgid "ui.title.subtitle"
msgstr "Tactical community rogue · Twenty-wave survival"
msgid "ui.frontend.subtitle"
msgstr "Eco round live · Full arsenal ready"
msgid "ui.frontend.build"
msgstr "PLAYTEST BUILD · TITLE TBD"
msgid "ui.codex.title"
msgstr "Loadout Codex"
msgid "ui.character.hint"
msgstr "Select one tactical operator from the grid below."

msgid "weapon.axe.name"
msgstr "Bowie Knife"
msgid "skin.weapon.axe.flavor"
msgstr "No rifle, no problem—spacing still clears rounds."
msgid "weapon.chainsaw.name"
msgstr "Butterfly Knife"
msgid "skin.weapon.chainsaw.flavor"
msgstr "Knife out for speed; keep the run's rhythm intact."
msgid "weapon.mace.name"
msgstr "M9 Bayonet"
msgid "skin.weapon.mace.flavor"
msgstr "Knife rounds reward patience and perfect distance."
msgid "weapon.punch.name"
msgstr "Shadow Daggers"
msgid "skin.weapon.punch.flavor"
msgstr "Two blades do not automatically mean twice the aim."
msgid "weapon.sword.name"
msgstr "Karambit"
msgid "skin.weapon.sword.flavor"
msgstr "Spin the knife, not your focus in a clutch."
msgid "weapon.wand.name"
msgstr "Zeus x27"
msgid "skin.weapon.wand.flavor"
msgstr "One close corner, one chance."
msgid "weapon.spear.name"
msgstr "Bayonet"
msgid "skin.weapon.spear.flavor"
msgstr "Hold the long angle and take first contact."
msgid "weapon.cleaver.name"
msgstr "Huntsman Knife"
msgid "skin.weapon.cleaver.flavor"
msgstr "It is not decoration; this cut actually bleeds."
msgid "weapon.laser.name"
msgstr "AWP"
msgid "skin.weapon.laser.flavor"
msgstr "One shot can carry the confidence of a whole round."
msgid "weapon.pistol.name"
msgstr "Glock-18"
msgid "skin.weapon.pistol.flavor"
msgstr "Even an eco round deserves discipline."
msgid "weapon.revolver.name"
msgstr "Desert Eagle"
msgid "skin.weapon.revolver.flavor"
msgstr "When the aim is warm, every line is head level."
msgid "weapon.shotgun.name"
msgstr "M4A4"
msgid "skin.weapon.shotgun.flavor"
msgstr "Control the burst; do not draw circles with the magazine."
msgid "weapon.smg.name"
msgstr "P90"
msgid "skin.weapon.smg.flavor"
msgstr "Go in first and plan the route later."
msgid "weapon.carbine.name"
msgstr "AK-47"
msgid "skin.weapon.carbine.flavor"
msgstr "The first bullet always deserves respect."
msgid "weapon.railbow.name"
msgstr "M4A1-S"
msgid "skin.weapon.railbow.flavor"
msgstr "Suppressed does not mean unnoticed."
msgid "weapon.shrapnel_launcher.name"
msgstr "UMP-45"
msgid "skin.weapon.shrapnel_launcher.flavor"
msgstr "An old friend for the light-buy round."
msgid "weapon.needler.name"
msgstr "MP9"
msgid "skin.weapon.needler.flavor"
msgstr "Dump the close burst and stack the mark."
msgid "weapon.boomerang.name"
msgstr "MAC-10"
msgid "skin.weapon.boomerang.flavor"
msgstr "Run-and-gun is not an excuse; it is the manual."
msgid "weapon.ember_staff.name"
msgstr "Molotov"
msgid "skin.weapon.ember_staff.flavor"
msgstr "Block the route with fire, then take the duel."
msgid "weapon.frost_orb.name"
msgstr "Smoke Grenade"
msgid "skin.weapon.frost_orb.flavor"
msgstr "Players who know their smokes tend to live longer."
msgid "weapon.storm_coil.name"
msgstr "Flashbang"
msgid "skin.weapon.storm_coil.flavor"
msgstr "I'm blind! You're blind too!"
msgid "weapon.void_prism.name"
msgstr "HE Grenade"
msgid "skin.weapon.void_prism.flavor"
msgstr "Check their health, then check the landing spot."
msgid "weapon.turret_kit.name"
msgstr "C4"
msgid "skin.weapon.turret_kit.flavor"
msgstr "Bomb planted. The clutch starts now."
msgid "weapon.drone_beacon.name"
msgstr "USP-S"
msgid "skin.weapon.drone_beacon.flavor"
msgstr "In the pistol round, steady the first shot."

msgid "passive.cape.name"
msgstr "Rush-Site Trainers"
msgid "skin.passive.cape.flavor"
msgstr "Hit the site fast; surviving the retake matters more."

msgid "passive.mighty_sword.name"
msgstr "Full-Buy Sheath"
msgid "skin.passive.mighty_sword.flavor"
msgstr "After a full buy, the knife should do more than inspect."

msgid "passive.power_ball.name"
msgstr "Pre-Aim Ball"
msgid "skin.passive.power_ball.flavor"
msgstr "Learn the head line first, then talk about feel."

msgid "passive.rage.name"
msgstr "Force-Buy Fury"
msgid "skin.passive.rage.flavor"
msgstr "When the balance is short, confidence fills the gap."

msgid "passive.coffee.name"
msgstr "Warm-Up Coffee"
msgid "skin.passive.coffee.flavor"
msgstr "Five minutes of warm-up saves one opening death."

msgid "passive.crack.name"
msgstr "Pixel-Gap Hold"
msgid "skin.passive.crack.flavor"
msgstr "If you can see the gap, you can hold the site."

msgid "passive.helmet.name"
msgstr "Smoke-Can Helmet"
msgid "skin.passive.helmet.flavor"
msgstr "Secure the can before you throw the smoke."

msgid "passive.toxic_sludge.name"
msgstr "Boost Step"
msgid "skin.passive.toxic_sludge.flavor"
msgstr "A legal boost with no room for daydreaming."

msgid "passive.butterfly.name"
msgstr "Training Lobster Claw"
msgid "skin.passive.butterfly.flavor"
msgstr "Even lobsters train close angles. Once it grips, it holds."

msgid "passive.flag.name"
msgstr "Halftime Tactics Board"
msgid "skin.passive.flag.flavor"
msgstr "No timeout available, so draw the plan now."

msgid "passive.knight_helmet.name"
msgstr "Full-Armor Helmet"
msgid "skin.passive.knight_helmet.flavor"
msgstr "Armor and helmet are ready; confidence should be too."

msgid "passive.leech.name"
msgstr "Clutch Syringe"
msgid "skin.passive.leech.flavor"
msgstr "Low health is not zero health. The next shot still counts."

msgid "passive.missile.name"
msgstr "Pre-Aim Tracer"
msgid "skin.passive.missile.flavor"
msgstr "Tracers tell the story; read them before spraying."

msgid "passive.muscle.name"
msgstr "Practice-Room Dumbbell"
msgid "skin.passive.muscle.flavor"
msgstr "Recoil takes a wrist; carrying takes practice."

msgid "passive.plant.name"
msgstr "Potted Angle"
msgid "skin.passive.plant.flavor"
msgstr "One more pot in the corner, one more angle to clear."

msgid "passive.round_hat.name"
msgstr "Lobster Hood"
msgid "skin.passive.round_hat.flavor"
msgstr "The hood brings the mood. Movement is still your job."

msgid "passive.telescope.name"
msgstr "High-Zoom Scope"
msgid "skin.passive.telescope.flavor"
msgstr "Hold the long angle; do not scope at point blank."

msgid "passive.vest.name"
msgstr "Kevlar Vest"
msgid "skin.passive.vest.flavor"
msgstr "Armor is for sale. Positioning is not."

msgid "passive.map.name"
msgstr "Utility Lineup Chalk"
msgid "skin.passive.map.flavor"
msgstr "Draw the smoke, fire and flash lineup before throwing anything."

msgid "passive.magazine.name"
msgstr "Three-Round Rhythm Mag"
msgid "skin.passive.magazine.flavor"
msgstr "Three shots per beat. Do not turn rhythm into a hose."

msgid "passive.close_quarters_manual.name"
msgstr "Close-Angle Claw"
msgid "skin.passive.close_quarters_manual.flavor"
msgstr "Clamp the corner and let nobody leave."

msgid "passive.rapid_loader.name"
msgstr "Mouse Reset Pad"
msgid "skin.passive.rapid_loader.flavor"
msgstr "Hit the edge of the desk, lift once, keep controlling the spray."

msgid "passive.sharpshooter_lens.name"
msgstr "Missed-Shot Charm"
msgid "skin.passive.sharpshooter_lens.flavor"
msgstr "That one missed. The next one had better not."

msgid "passive.ember_reservoir.name"
msgstr "Incendiary Fuel"
msgid "skin.passive.ember_reservoir.flavor"
msgstr "This bottle is not a drink. It is route-denial budget."

msgid "passive.frost_capacitor.name"
msgstr "Smoke Condenser"
msgid "skin.passive.frost_capacitor.flavor"
msgstr "A clean smoke removes half the clutch problems."

msgid "passive.storm_conductor.name"
msgstr "Anti-Flash Goggles"
msgid "skin.passive.storm_conductor.flavor"
msgstr "A teammate flash is still a flash. Goggles pick no side."

msgid "passive.turret_gears.name"
msgstr "Auto-Turret Parts"
msgid "skin.passive.turret_gears.flavor"
msgstr "Even engineering needs proper crossfire."

msgid "passive.drone_uplink.name"
msgstr "Recon Drone Uplink"
msgid "skin.passive.drone_uplink.flavor"
msgstr "It watches the site. You finish the trade."

msgid "passive.dash_blades.name"
msgstr "Knife-Out Straps"
msgid "skin.passive.dash_blades.flavor"
msgstr "Knife out for speed, not into the enemy's face."

msgid "passive.blood_vial.name"
msgstr "Field Blood Bag"
msgid "skin.passive.blood_vial.flavor"
msgstr "Every point of health is economy in a clutch."

msgid "passive.merchant_badge.name"
msgstr "Eco-Round Pass"
msgid "skin.passive.merchant_badge.flavor"
msgstr "What you save now speaks in the next round."

msgid "passive.fortune_charm.name"
msgstr "Case-Luck Charm"
msgid "skin.passive.fortune_charm.flavor"
msgstr "Case superstition adds no damage, only morale."

msgid "passive.echo_round.name"
msgstr "Post-Duel Microphone"
msgid "skin.passive.echo_round.flavor"
msgstr "Win the duel, then answer the microphone already in your face."

msgid "passive.volatile_core.name"
msgstr "Red-X Grenade"
msgid "skin.passive.volatile_core.flavor"
msgstr "The red X is not a warning. It is an instruction."

msgid "passive.cinder_seed.name"
msgstr "Fire-Zone Ember"
msgid "skin.passive.cinder_seed.flavor"
msgstr "The fire is out; the damage remembers."

msgid "passive.arc_lens.name"
msgstr "Flash Prism"
msgid "skin.passive.arc_lens.flavor"
msgstr "Bend the white light somewhere other than your eyes."

msgid "passive.hunter_mark.name"
msgstr "Jump-Shot Charm"
msgid "skin.passive.hunter_mark.flavor"
msgstr "The jump is not retreat. It is a new sightline."

msgid "passive.panic_guard.name"
msgstr "Site-Anchor Bandana"
msgid "skin.passive.panic_guard.flavor"
msgstr "A site can fall. Your composure cannot."

msgid "passive.last_breath.name"
msgstr "Clutch Stopwatch"
msgid "skin.passive.last_breath.flavor"
msgstr "When the timer starts, the whole team finally goes quiet."

msgid "passive.harvest_bell.name"
msgstr "Round-Bonus Bell"
msgid "skin.passive.harvest_bell.flavor"
msgstr "The end of the round is the real payday."

msgid "passive.salvage_hook.name"
msgstr "Weapon-Salvage Hook"
msgid "skin.passive.salvage_hook.flavor"
msgstr "Leave a weapon on the floor and the economy remembers."

msgid "passive.thorn_mesh.name"
msgstr "Anti-Rush Wire"
msgid "skin.passive.thorn_mesh.flavor"
msgstr "The rush can enter after it pays the toll."

msgid "passive.dash_charge.name"
msgstr "Knife-Out Battery"
msgid "skin.passive.dash_charge.flavor"
msgstr "Draw the knife and your legs remember the route."

msgid "passive.battle_rhythm.name"
msgstr "Warm-Up Cassette"
msgid "skin.passive.battle_rhythm.flavor"
msgstr "When the warm-up track starts, the crosshair wakes first."

msgid "passive.scrap_ledger.name"
msgstr "Eco Coin Pouch"
msgid "skin.passive.scrap_ledger.flavor"
msgstr "Save every coin now; bring the full buy next wave."

msgid "passive.lucky_token.name"
msgstr "Hand-Cannon Comeback Coin"
msgid "skin.passive.lucky_token.flavor"
msgstr "One clean first shot can flip an eco round."

msgid "passive.market_map.name"
msgstr "Buy-Menu Price Sheet"
msgid "skin.passive.market_map.flavor"
msgstr "Three seconds to buy, a whole wave to balance the books."

msgid "passive.recycler_stamp.name"
msgstr "Salvage Stamp"
msgid "skin.passive.recycler_stamp.flavor"
msgstr "Old gear feeds the next wave."

msgid "passive.golden_seed.name"
msgstr "Win-Streak Seed"
msgid "skin.passive.golden_seed.flavor"
msgstr "Do not waste the streak money. The boss is still ahead."

msgid "passive.bargain_chip.name"
msgstr "Half-Buy Chip"
msgid "skin.passive.bargain_chip.flavor"
msgstr "A half buy is not half effort. Spend where it matters."

msgid "passive.prospector_eye.name"
msgstr "Drop Scanner"
msgid "skin.passive.prospector_eye.flavor"
msgstr "Crates do not glow on their own unless luck says so."

msgid "passive.interest_coil.name"
msgstr "Save-Round Watch"
msgid "skin.passive.interest_coil.flavor"
msgstr "Anything you save becomes interest for the next wave."

msgid "passive.iron_bark.name"
msgstr "Reinforced Crate Plank"
msgid "skin.passive.iron_bark.flavor"
msgstr "The crate may break. The position must remain."

msgid "passive.medic_patch.name"
msgstr "Field Medic Patch"
msgid "skin.passive.medic_patch.flavor"
msgstr "Patch up and keep fighting. Read instructions off the firing line."

msgid "passive.evasion_mesh.name"
msgstr "Silent-Step Mask"
msgid "skin.passive.evasion_mesh.flavor"
msgstr "Walking silently is not slow. It makes the enemy guess wrong."

msgid "passive.blood_filter.name"
msgstr "Hemostatic Filter"
msgid "skin.passive.blood_filter.flavor"
msgstr "Turn bleeding into one more shot of life."

msgid "passive.shock_padding.name"
msgstr "Recoil Padding"
msgid "skin.passive.shock_padding.flavor"
msgstr "Padding softens recoil. The first shot still needs discipline."

msgid "passive.second_skin.name"
msgstr "Spare Armor Plate"
msgid "skin.passive.second_skin.flavor"
msgstr "When the first layer breaks, the clutch keeps a backup."

msgid "passive.repair_gel.name"
msgstr "Hot Defuse Pliers"
msgid "skin.passive.repair_gel.flavor"
msgstr "The defuse can be hot. Your hand cannot shake."

msgid "passive.guardian_core.name"
msgstr "Broadcast Control Desk"
msgid "skin.passive.guardian_core.flavor"
msgstr "The broadcast is live. Do not turn the clutch into theater."
