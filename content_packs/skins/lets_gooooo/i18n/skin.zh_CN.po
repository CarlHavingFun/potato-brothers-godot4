msgid ""
msgstr ""
"Project-Id-Version: Game Prototype 1.0\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "ui.product_name"
msgstr "游戏原型"
msgid "ui.title.name"
msgstr "游戏原型"
msgid "ui.title.subtitle"
msgstr "战术射击社区梗 · 二十波生存"
msgid "ui.frontend.subtitle"
msgstr "经济局开打 · 全武器就绪"
msgid "ui.frontend.build"
msgstr "试玩构建 · 名称待定"
msgid "ui.codex.title"
msgstr "装备图鉴"
msgid "ui.character.hint"
msgstr "从下方网格选择一名战术干员。"

msgid "weapon.axe.name"
msgstr "鲍伊猎刀"
msgid "skin.weapon.axe.flavor"
msgstr "买不起枪，也能靠距离感清场。"
msgid "weapon.chainsaw.name"
msgstr "蝴蝶刀"
msgid "skin.weapon.chainsaw.flavor"
msgstr "切刀赶路，别把整局节奏切没了。"
msgid "weapon.mace.name"
msgstr "M9 刺刀"
msgid "skin.weapon.mace.flavor"
msgstr "刀局别急，重刀更要看准距离。"
msgid "weapon.punch.name"
msgstr "暗影双匕"
msgid "skin.weapon.punch.flavor"
msgstr "两把都到手，不代表两倍准。"
msgid "weapon.sword.name"
msgstr "爪子刀"
msgid "skin.weapon.sword.flavor"
msgstr "转刀可以，残局别走神。"
msgid "weapon.wand.name"
msgstr "Zeus x27"
msgid "skin.weapon.wand.flavor"
msgstr "拐角贴脸，只有一次机会。"
msgid "weapon.spear.name"
msgstr "刺刀"
msgid "skin.weapon.spear.flavor"
msgstr "长手架住，先到先得。"
msgid "weapon.cleaver.name"
msgstr "猎杀者匕首"
msgid "skin.weapon.cleaver.flavor"
msgstr "这刀不是装饰，真的会流血。"
msgid "weapon.laser.name"
msgstr "AWP"
msgid "skin.weapon.laser.flavor"
msgstr "一枪，就是一个回合的底气。"
msgid "weapon.pistol.name"
msgstr "Glock-18"
msgid "skin.weapon.pistol.flavor"
msgstr "经济局也要打出纪律。"
msgid "weapon.revolver.name"
msgstr "沙漠之鹰"
msgid "skin.weapon.revolver.flavor"
msgstr "手感来了，准星里全是头线。"
msgid "weapon.shotgun.name"
msgstr "M4A4"
msgid "skin.weapon.shotgun.flavor"
msgstr "稳住压枪，别一梭子画圈。"
msgid "weapon.smg.name"
msgstr "P90"
msgid "skin.weapon.smg.flavor"
msgstr "冲进去再说，路线之后再想。"
msgid "weapon.carbine.name"
msgstr "AK-47"
msgid "skin.weapon.carbine.flavor"
msgstr "第一发永远值得尊重。"
msgid "weapon.railbow.name"
msgstr "M4A1-S"
msgid "skin.weapon.railbow.flavor"
msgstr "消音不代表没有存在感。"
msgid "weapon.shrapnel_launcher.name"
msgstr "UMP-45"
msgid "skin.weapon.shrapnel_launcher.flavor"
msgstr "半甲经济局的老朋友。"
msgid "weapon.needler.name"
msgstr "MP9"
msgid "skin.weapon.needler.flavor"
msgstr "近点一梭子，先把标记叠满。"
msgid "weapon.boomerang.name"
msgstr "MAC-10"
msgid "skin.weapon.boomerang.flavor"
msgstr "跑打不是借口，是这把枪的说明书。"
msgid "weapon.ember_staff.name"
msgstr "燃烧瓶"
msgid "skin.weapon.ember_staff.flavor"
msgstr "火先封路，人再补枪。"
msgid "weapon.frost_orb.name"
msgstr "烟雾弹"
msgid "skin.weapon.frost_orb.flavor"
msgstr "会封烟的人，往往活得更久。"
msgid "weapon.storm_coil.name"
msgstr "闪光弹"
msgid "skin.weapon.storm_coil.flavor"
msgstr "我白了！你也白了！"
msgid "weapon.void_prism.name"
msgstr "高爆手雷"
msgid "skin.weapon.void_prism.flavor"
msgstr "先问血量，再问落点。"
msgid "weapon.turret_kit.name"
msgstr "C4"
msgid "skin.weapon.turret_kit.flavor"
msgstr "包已下，残局现在开始。"
msgid "weapon.drone_beacon.name"
msgstr "USP-S"
msgid "skin.weapon.drone_beacon.flavor"
msgstr "手枪局先稳住第一发。"

msgid "passive.cape.name"
msgstr "抢点跑鞋"
msgid "skin.passive.cape.flavor"
msgstr "抢点要快，活着回防更重要。"

msgid "passive.mighty_sword.name"
msgstr "全起刀鞘"
msgid "skin.passive.mighty_sword.flavor"
msgstr "全起之后，别让刀只负责检视。"

msgid "passive.power_ball.name"
msgstr "预瞄训练球"
msgid "skin.passive.power_ball.flavor"
msgstr "先把头线记住，再谈手感。"

msgid "passive.rage.name"
msgstr "强起怒火"
msgid "skin.passive.rage.flavor"
msgstr "余额不够，气势来凑。"

msgid "passive.coffee.name"
msgstr "热身咖啡"
msgid "skin.passive.coffee.flavor"
msgstr "热身五分钟，少送一个首杀。"

msgid "passive.crack.name"
msgstr "墙缝架点"
msgid "skin.passive.crack.flavor"
msgstr "看得到一条缝，就守得住一个点。"

msgid "passive.helmet.name"
msgstr "烟雾罐头盔"
msgid "skin.passive.helmet.flavor"
msgstr "封烟之前，先把罐子戴稳。"

msgid "passive.toxic_sludge.name"
msgstr "架点踏台"
msgid "skin.passive.toxic_sludge.flavor"
msgstr "合法垫脚，拒绝走神。"

msgid "passive.butterfly.name"
msgstr "训练虾钳"
msgid "skin.passive.butterfly.flavor"
msgstr "龙虾也练近点，夹住就不松。"

msgid "passive.flag.name"
msgstr "半场战术板"
msgid "skin.passive.flag.flavor"
msgstr "暂停没有，战术先画。"

msgid "passive.knight_helmet.name"
msgstr "全甲头盔"
msgid "skin.passive.knight_helmet.flavor"
msgstr "有甲有头，信心也得跟上。"

msgid "passive.leech.name"
msgstr "续命针管"
msgid "skin.passive.leech.flavor"
msgstr "残血别慌，下一枪还有机会。"

msgid "passive.missile.name"
msgstr "预瞄曳光弹"
msgid "skin.passive.missile.flavor"
msgstr "弹道会说话，先听清再压枪。"

msgid "passive.muscle.name"
msgstr "训练房哑铃"
msgid "skin.passive.muscle.flavor"
msgstr "压枪靠手腕，扛枪靠训练。"

msgid "passive.plant.name"
msgstr "假盆栽架点"
msgid "skin.passive.plant.flavor"
msgstr "角落多一盆，预瞄多一层。"

msgid "passive.round_hat.name"
msgstr "龙虾头套"
msgid "skin.passive.round_hat.flavor"
msgstr "头套只负责气氛，走位还得自己来。"

msgid "passive.telescope.name"
msgstr "高倍瞄镜"
msgid "skin.passive.telescope.flavor"
msgstr "远点架住，近点别开镜。"

msgid "passive.vest.name"
msgstr "凯夫拉背心"
msgid "skin.passive.vest.flavor"
msgstr "甲可以买，站位买不到。"

msgid "passive.map.name"
msgstr "道具阵容粉笔"
msgid "skin.passive.map.flavor"
msgstr "烟火闪怎么丢，地上先画一遍。"

msgid "passive.magazine.name"
msgstr "三发节拍弹匣"
msgid "skin.passive.magazine.flavor"
msgstr "三发一组，别把节奏打成泼水。"

msgid "passive.close_quarters_manual.name"
msgstr "近点虾钳"
msgid "skin.passive.close_quarters_manual.flavor"
msgstr "拐角一夹，谁都别跑。"

msgid "passive.rapid_loader.name"
msgstr "抬鼠重置垫"
msgid "skin.passive.rapid_loader.flavor"
msgstr "鼠标甩到桌边，抬一下还能继续压。"

msgid "passive.sharpshooter_lens.name"
msgstr "空枪挂坠"
msgid "skin.passive.sharpshooter_lens.flavor"
msgstr "这一枪没中，下一枪别再空。"

msgid "passive.ember_reservoir.name"
msgstr "燃烧瓶燃料"
msgid "skin.passive.ember_reservoir.flavor"
msgstr "这瓶不是饮料，是封路预算。"

msgid "passive.frost_capacitor.name"
msgstr "烟雾冷凝罐"
msgid "skin.passive.frost_capacitor.flavor"
msgstr "烟封得好，残局少一半麻烦。"

msgid "passive.storm_conductor.name"
msgstr "防白护目镜"
msgid "skin.passive.storm_conductor.flavor"
msgstr "队友闪也算闪，护目镜不分阵营。"

msgid "passive.turret_gears.name"
msgstr "自动炮台零件"
msgid "skin.passive.turret_gears.flavor"
msgstr "工程位也得学会交叉火力。"

msgid "passive.drone_uplink.name"
msgstr "侦察机链路"
msgid "skin.passive.drone_uplink.flavor"
msgstr "它负责看点，你负责补枪。"

msgid "passive.dash_blades.name"
msgstr "切刀加速绑带"
msgid "skin.passive.dash_blades.flavor"
msgstr "切刀赶路，别切到敌人脸上。"

msgid "passive.blood_vial.name"
msgstr "急救血袋"
msgid "skin.passive.blood_vial.flavor"
msgstr "残局里每一点生命都算经济。"

msgid "passive.merchant_badge.name"
msgstr "经济局通行证"
msgid "skin.passive.merchant_badge.flavor"
msgstr "这回合省下的，下一回合会说话。"

msgid "passive.fortune_charm.name"
msgstr "开箱幸运挂件"
msgid "skin.passive.fortune_charm.flavor"
msgstr "开箱玄学不加伤害，但加心情。"

msgid "passive.echo_round.name"
msgstr "对枪采访麦"
msgid "skin.passive.echo_round.flavor"
msgstr "赢了先别走，麦克风已经递到脸上。"

msgid "passive.volatile_core.name"
msgstr "红叉高爆雷"
msgid "skin.passive.volatile_core.flavor"
msgstr "红叉不是警告，是操作说明。"

msgid "passive.cinder_seed.name"
msgstr "火场余烬"
msgid "skin.passive.cinder_seed.flavor"
msgstr "火灭了，伤害记忆还在。"

msgid "passive.arc_lens.name"
msgstr "闪光折射镜"
msgid "skin.passive.arc_lens.flavor"
msgstr "让白光拐个弯，别全进自己眼睛。"

msgid "passive.hunter_mark.name"
msgstr "跳狙挂件"
msgid "skin.passive.hunter_mark.flavor"
msgstr "起跳不是逃跑，是换一条枪线。"

msgid "passive.panic_guard.name"
msgstr "守点头巾"
msgid "skin.passive.panic_guard.flavor"
msgstr "点位可以丢，人不能先乱。"

msgid "passive.last_breath.name"
msgstr "残局秒表"
msgid "skin.passive.last_breath.flavor"
msgstr "秒表一响，全队开始闭麦。"

msgid "passive.harvest_bell.name"
msgstr "回合奖励铃"
msgid "skin.passive.harvest_bell.flavor"
msgstr "回合结束才是真正的发薪日。"

msgid "passive.salvage_hook.name"
msgstr "捡枪钩"
msgid "skin.passive.salvage_hook.flavor"
msgstr "地上的枪不捡，经济会记仇。"

msgid "passive.thorn_mesh.name"
msgstr "防冲锋铁丝网"
msgid "skin.passive.thorn_mesh.flavor"
msgstr "冲锋能进，代价得先交。"

msgid "passive.dash_charge.name"
msgstr "切刀冲锋电池"
msgid "skin.passive.dash_charge.flavor"
msgstr "刀一掏，腿就知道该往哪走。"

msgid "passive.battle_rhythm.name"
msgstr "热身磁带"
msgid "skin.passive.battle_rhythm.flavor"
msgstr "热身曲一响，准星先醒。"

msgid "passive.scrap_ledger.name"
msgstr "经济局零钱袋"
msgid "skin.passive.scrap_ledger.flavor"
msgstr "钢镚攒进袋里，长枪留到下一波。"

msgid "passive.lucky_token.name"
msgstr "手炮翻盘币"
msgid "skin.passive.lucky_token.flavor"
msgstr "只要第一发够准，经济局也能翻。"

msgid "passive.market_map.name"
msgstr "装备价格表"
msgid "skin.passive.market_map.flavor"
msgstr "买枪三秒，算账一整波。"

msgid "passive.recycler_stamp.name"
msgstr "回收印章"
msgid "skin.passive.recycler_stamp.flavor"
msgstr "旧装备不浪费，下一波继续养。"

msgid "passive.golden_seed.name"
msgstr "连胜奖金种子"
msgid "skin.passive.golden_seed.flavor"
msgstr "连胜的钱别乱花，首领还在后面。"

msgid "passive.bargain_chip.name"
msgstr "半起筹码"
msgid "skin.passive.bargain_chip.flavor"
msgstr "半起不是半打，资源要花在刀刃上。"

msgid "passive.prospector_eye.name"
msgstr "掉落扫描镜"
msgid "skin.passive.prospector_eye.flavor"
msgstr "箱子不会自己发光，除非你够幸运。"

msgid "passive.interest_coil.name"
msgstr "保枪怀表"
msgid "skin.passive.interest_coil.flavor"
msgstr "能保下来，就是下一波的利息。"

msgid "passive.iron_bark.name"
msgstr "加固木箱板"
msgid "skin.passive.iron_bark.flavor"
msgstr "箱子会碎，阵地得留下。"

msgid "passive.medic_patch.name"
msgstr "急救贴"
msgid "skin.passive.medic_patch.flavor"
msgstr "贴上继续打，别在火线上看说明书。"

msgid "passive.evasion_mesh.name"
msgstr "静步面罩"
msgid "skin.passive.evasion_mesh.flavor"
msgstr "静步不是慢，是让对面先猜错。"

msgid "passive.blood_filter.name"
msgstr "止血滤芯"
msgid "skin.passive.blood_filter.flavor"
msgstr "把失血变成多活一枪。"

msgid "passive.shock_padding.name"
msgstr "防震护垫"
msgid "skin.passive.shock_padding.flavor"
msgstr "后坐能缓，第一发还是得稳。"

msgid "passive.second_skin.name"
msgstr "备用甲片"
msgid "skin.passive.second_skin.flavor"
msgstr "第一层破了，还有一层残局底气。"

msgid "passive.repair_gel.name"
msgstr "燃烧拆弹钳"
msgid "skin.passive.repair_gel.flavor"
msgstr "拆包可以烫手，手不能抖。"

msgid "passive.guardian_core.name"
msgstr "转播控制台"
msgid "skin.passive.guardian_core.flavor"
msgstr "画面在播，残局别演。"
