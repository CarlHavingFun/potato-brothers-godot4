[gd_resource type="Resource" script_class="CharacterDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://core/content/character_def.gd" id="1_character"]
[ext_resource type="PackedScene" path="res://content_packs/characters/niko/niko.tscn" id="2_scene"]
[ext_resource type="Resource" path="res://content_packs/characters/niko/stats_niko.tres" id="3_stats"]
[ext_resource type="Script" path="res://core/combat/character_rule_def.gd" id="4_rules"]

[sub_resource type="Resource" id="Rules_niko"]
script = ExtResource("4_rules")
rule_id = &"character_rule/niko"
core_ability_id = &"ability/well_rounded"
starting_stat_modifiers = {
"damage": 2.0,
"max_health": 2.0
}

[resource]
script = ExtResource("1_character")
scene = ExtResource("2_scene")
stats = ExtResource("3_stats")
starter_weapon_ids = Array[StringName]([&"core:weapon/axe", &"core:weapon/chainsaw", &"core:weapon/mace", &"core:weapon/punch", &"core:weapon/sword", &"core:weapon/wand", &"core:weapon/laser", &"core:weapon/pistol", &"core:weapon/revolver", &"core:weapon/shotgun", &"core:weapon/smg", &"core:weapon/spear", &"core:weapon/cleaver", &"core:weapon/carbine", &"core:weapon/railbow", &"core:weapon/shrapnel_launcher", &"core:weapon/needler", &"core:weapon/boomerang", &"core:weapon/ember_staff", &"core:weapon/frost_orb", &"core:weapon/storm_coil", &"core:weapon/void_prism", &"core:weapon/turret_kit", &"core:weapon/drone_beacon"])
rules = SubResource("Rules_niko")
content_id = &"character/niko"
presentation_id = &"character.niko"
display_name_key = &"character.niko.name"
description_key = &"character.niko.description"
tags = Array[StringName]([&"balanced", &"adventurer"])
