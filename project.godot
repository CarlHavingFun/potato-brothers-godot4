[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="hostile_attack"
2d_physics/layer_4="enemy_hurtbox"
2d_physics/layer_5="friendly_attack"
2d_physics/layer_6="player_hurtbox"
2d_physics/layer_7="pickup"
2d_physics/layer_8="world"

[presentation]

skin_manifest="res://content_packs/skins/dev_placeholder/skin.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
